  trabajaPara(Jefe, Persona),
  esMafioso(Jefe),
  encargo(Jefe,Persona,cuidar(Cuidado)),
  pareja(Jefe, Cuidado).

enProblemas(Persona) :-
   encargo(_,Persona,buscar(Buscado,_)),
   personaje(Buscado, boxeador).

